 "web/src/app/account/SkipWeek.tsx": [
  {
   "first": 19,
   "lines": [
    "export function SkipWeek({ box }: { box: Box }) {",
    "  const [skipped, setSkipped] = useState(box.skipped);",
    "  const [busy, setBusy] = useState(false);",
    "  const closed = isPastCutOff(box.weekStart);",
    "",
    "  async function toggle() {",
    "    setBusy(true);",
    "    try {",
    "      await api('/account/skip', {",
    "        method: 'POST',",
    "        body: { weekStart: box.weekStart, skip: !skipped },",
    "      });",
    "      setSkipped(!skipped);",
    "    } finally {",
    "      setBusy(false);",
    "    }",
    "  }",
    "",
    "  if (closed) return <span className=\"note\">Being packed</span>;",
    "  return (",
    "    <button onClick={toggle} disabled={busy}>",
    "      {skipped ? 'Un-skip this week' : 'Skip this week'}",
    "    </button>",
    "  );",
    "}"
   ]
  }
 ],

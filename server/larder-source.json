    "export function PausePlan({ plan }: { plan: Plan }) {",
    "  const [until, setUntil] = useState(plan.pausedUntil ?? '');",
    "  const [saved, setSaved] = useState(false);",
    "",
    "  async function pause(event: FormEvent) {",
    "    event.preventDefault();",
    "    await api('/account/pause', { method: 'POST', body: { until } });",
    "    setSaved(true);",
    "  }",
    "",
    "  return (",
    "    <form className=\"pause\" onSubmit={pause}>",
    "      <label htmlFor=\"until\">Pause deliveries until</label>",
    "      <input",
    "        id=\"until\"",
    "        type=\"date\"",
    "        min={nextDeliveryDay(new Date(), plan.deliveryDay)}",
    "        value={until}",
    "        onChange={(e) => setUntil(e.target.value)}",
    "      />",
    "      <button type=\"submit\">Pause my plan</button>",
    "      {saved && <p className=\"note\">Paused. No boxes until then.</p>}",
    "    </form>",
    "  );",
    "}"
   ]
  }
 ],

    "// POST /account/skip: skip, or un-skip, one upcoming week.",
    "account.post('/account/skip', requireLogin, async (req, res) => {",
    "  const { weekStart, skip } = req.body as SkipRequest;",
    "  const plan = await planFor(req.customer.id);",
    "  if (isPastCutOff(weekStart)) {",
    "    return res.status(409).json({ error: 'That week has closed' });",
    "  }",
    "  if (skip) await skipWeek(plan.id, weekStart);",
    "  else await unskipWeek(plan.id, weekStart);",
    "  res.json({ weekStart, skipped: skip });",
    "});",
    "",
    "// POST /account/pause: no boxes until a chosen date.",
    "account.post('/account/pause', requireLogin, async (req, res) => {",
    "  const until = parseDate(req.body.until);",
    "  const plan = await planFor(req.customer.id);",
    "  await pausePlan(plan.id, until);",
    "  res.json({ pausedUntil: until });",
    "});"
   ]
  }
 ],
 "api/src/routes/webhooks.ts": [
  {
   "first": 29,
   "lines": [
    "// Stripe calls this when a payment goes through or fails.",
    "webhooks.post('/webhooks/stripe', rawBody, async (req, res) => {",
    "  const signature = req.get('stripe-signature');",
    "  const event = verifyStripeEvent(req.body, signature);",
    "  if (!event) return res.status(400).end();",
    "",
    "  const orderId = event.data.object.metadata.orderId;",
    "  if (event.type === 'payment_intent.succeeded') {",
    "    const order = await markPaid(orderId);",
    "    await sendEmail(order.email, 'receipt', {",
    "      amount: order.pricePence,",
    "      deliveryDate: order.deliveryDate,",
    "    });",
    "  } else if (event.type === 'payment_intent.payment_failed') {",
    "    const order = await markDeclined(orderId);",
    "    await sendEmail(order.email, 'cardDeclined', { retryInDays: 2 });",
    "  }",
    "  res.json({ received: true });",
    "});"
   ]
  }
 ],

   "lines": [
    "/** Starts the server and plugs in every endpoint. */",
    "export function startServer(port = Number(process.env.PORT ?? 4000)) {",
    "  const app = express();",
    "  app.use(cors({ origin: ALLOWED_ORIGINS }));",
    "",
    "  // Stripe signs the raw body: its webhook goes before the parser.",
    "  app.use(webhooks);",
    "  app.use(express.json());",
    "",
    "  app.use(menu);",
    "  app.use(checkout);",
    "  app.use(account);",
    "  app.use(admin);",
    "",
    "  app.get('/health', (_req, res) => res.json({ ok: true }));",
    "  app.use(onError);",
    "",
    "  return app.listen(port, () => {",
    "    console.log(`Larder server listening on ${port}`);",
    "  });",
    "}"
   ]
  }
 ],

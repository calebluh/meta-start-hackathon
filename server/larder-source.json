 "infra/docker-compose.yml": [
  {
   "first": 1,
   "lines": [
    "# Runs the server and its database on a laptop:",
    "#   docker compose -f infra/docker-compose.yml up",
    "version: \"3.9\"",
    "",
    "services:",
    "  api:",
    "    build:",
    "      context: ..",
    "      dockerfile: api/Dockerfile",
    "    ports:",
    "      - \"4000:4000\"",
    "    environment:",
    "      DATABASE_URL: postgres://larder:larder@db:5432/larder",
    "      STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY}",
    "      POSTMARK_TOKEN: ${POSTMARK_TOKEN}",
    "      PHOTO_BUCKET: larder-photos-dev",
    "    depends_on:",
    "      db:",
    "        condition: service_healthy",
    "    volumes:",
    "      - ../api/src:/app/api/src",
    "",
    "  jobs:",
    "    build:",
    "      context: ..",
    "      dockerfile: jobs/Dockerfile",
    "    environment:",
    "      DATABASE_URL: postgres://larder:larder@db:5432/larder",
    "      STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY}",
    "    depends_on:",
    "      - api",
    "",
    "  db:",
    "    image: postgres:16",
    "    environment:",
    "      POSTGRES_USER: larder",
    "      POSTGRES_PASSWORD: larder",
    "      POSTGRES_DB: larder",
    "    healthcheck:",
    "      test: [\"CMD\", \"pg_isready\", \"-U\", \"larder\"]",
    "      interval: 5s",
    "    volumes:",
    "      - pgdata:/var/lib/postgresql/data",
    "",
    "volumes:",
    "  pgdata: {}"
   ]
  }
 ],
 "infra/deploy.yml": [
  {
   "first": 1,
   "lines": [
    "# Builds and ships the apps on every merge to main.",
    "name: Deploy",
    "",
    "on:",
    "  push:",
    "    branches: [main]",
    "",
    "jobs:",
    "  test:",
    "    runs-on: ubuntu-latest",
    "    services:",
    "      postgres:",
    "        image: postgres:16",
    "        env:",
    "          POSTGRES_PASSWORD: larder",
    "        ports: [\"5432:5432\"]",
    "    steps:",
    "      - uses: actions/checkout@v4",
    "      - uses: actions/setup-node@v4",
    "        with:",
    "          node-version: 22",
    "          cache: npm",
    "      - run: npm ci",
    "      - run: npm run migrate",
    "      - run: npm test",
    "",
    "  ship:",
    "    needs: test",
    "    runs-on: ubuntu-latest",
    "    strategy:",
    "      matrix:",
    "        app: [web, admin, api, jobs]",
    "    env:",
    "      IMAGE: ghcr.io/larder/${{ matrix.app }}:${{ github.sha }}",
    "    steps:",
    "      - uses: actions/checkout@v4",
    "      - name: Build the image",
    "        run: docker build -f ${{ matrix.app }}/Dockerfile -t $IMAGE .",
    "      - name: Push it",
    "        run: docker push $IMAGE",
    "      - name: Roll it out",
    "        run: ./infra/rollout.sh ${{ matrix.app }} ${{ github.sha }}",
    "        env:",
    "          DEPLOY_TOKEN: ${{ secrets.DEPLOY_TOKEN }}"
   ]
  }
 ]
}

    "/** Starts a weekly plan for a customer who has just checked out. */",
    "export async function startSubscription(",
    "  customerId: string,",
    "  details: PlanDetails,",
    "): Promise<Plan> {",
    "  const existing = await planFor(customerId);",
    "  if (existing && existing.status === 'active') {",
    "    throw new OrderError('This customer already has a plan');",
    "  }",
    "  return insertPlan({",
    "    customerId,",
    "    boxSize: details.boxSize,",
    "    deliveryDay: details.deliveryDay,",
    "    address: details.address,",
    "    status: 'active',",
    "    startedAt: new Date(),",
    "  });",
    "}"
   ]
  },
  {
   "first": 118,
   "lines": [
    "/** Skips one week of a plan: no charge and no box for that week. */",
    "export async function skipWeek(planId: string, weekStart: string) {",
    "  const plan = await planById(planId);",
    "  if (plan.status !== 'active') {",
    "    throw new OrderError('Only an active plan can skip a week');",
    "  }",
    "  // One row per plan and week; skipping twice changes nothing.",
    "  await insertSkip(planId, weekStart);",
    "}",
    "",
    "/** Stops deliveries until a date, without cancelling the plan. */",
    "export async function pausePlan(planId: string, until: string) {",
    "  await updatePlan(planId, { status: 'paused', pausedUntil: until });",
    "}"
   ]
  }
 ],
 "api/src/orders/weekly.ts": [
  {
   "first": 27,
   "lines": [
    "/** Turns every active plan into an order for the week given. */",
    "export async function buildWeeklyOrders(weekStart: string) {",
    "  // Skipped and paused weeks are left out by the query itself.",
    "  const plans = await activePlansFor(weekStart);",
    "  const orders: Order[] = [];",
    "",
    "  for (const plan of plans) {",
    "    const already = await orderFor(plan.id, weekStart);",
    "    if (already) {",
    "      orders.push(already);",
    "      continue;",
    "    }",
    "    orders.push(",
    "      await insertOrder({",
    "        planId: plan.id,",
    "        weekStart,",
    "        deliveryDate: nextDeliveryDay(weekStart, plan.deliveryDay),",
    "        pricePence: boxPrice(plan.boxSize, plan.addOns),",
    "        status: 'due',",
    "      }),",
    "    );",
    "  }",
    "  return orders;",
    "}"
   ]
  }
 ],
 "api/src/orders/pricing.ts": [
  {
   "first": 18,
   "lines": [
    "/** A box's price in pence, before tax, from its size and add-ons. */",
    "export function boxPrice(size: BoxSize, addOns: AddOn[] = []) {",
    "  const base = BASE_PRICE_PENCE[size];",
    "  const extras = addOns.reduce(",
    "    (sum, addOn) => sum + ADD_ON_PRICE_PENCE[addOn],",
    "    0,",
    "  );",
    "  // A family box with two or more add-ons gets 10% off the add-ons.",
    "  const discount = size === 'family' && addOns.length >= 2 ? 0.1 : 0;",
    "  return Math.round(base + extras * (1 - discount));",
    "}"
   ]
  }
 ],
 "api/src/payments/stripe.ts": [
  {
   "first": 44,
   "lines": [
    "/** Charges one order to the card Stripe holds for its customer. */",
    "export async function chargeBox(order: Order): Promise<ChargeResult> {",
    "  const customer = await stripeCustomerFor(order.planId);",
    "  try {",
    "    const intent = await stripe.paymentIntents.create({",
    "      amount: withTax(order.pricePence, TAX_RATE),",
    "      currency: 'gbp',",
    "      customer: customer.id,",
    "      payment_method: customer.defaultCard,",
    "      off_session: true,",
    "      confirm: true,",
    "      metadata: { orderId: order.id },",
    "    });",
    "    return { ok: true, chargeId: intent.id };",
    "  } catch (error) {",
    "    if (!isCardDeclined(error)) throw error;",
    "    return { ok: false, reason: 'declined' };",
    "  }",
    "}"
   ]
  },
  {
   "first": 96,
   "lines": [
    "/** Gives money back on a charge: all of it, or part. */",
    "export async function refundCharge(chargeId: string, amount: number) {",
    "  return stripe.refunds.create({",
    "    payment_intent: chargeId,",
    "    amount,",
    "    reason: 'requested_by_customer',",
    "  });",
    "}"
   ]
  }
 ],
 "api/src/payments/refunds.ts": [
  {
   "first": 22,
   "lines": [
    "/** How much to give back for a box, in pence, by what went wrong. */",
    "export function refundAmount(order: Order, reason: RefundReason) {",
    "  const paid = withTax(order.pricePence, TAX_RATE);",
    "  switch (reason) {",
    "    case 'damaged':",
    "    case 'never_arrived':",
    "      return paid;",
    "    case 'late':",
    "      return Math.round(paid / 2);",
    "    case 'missing_item':",
    "      return Math.round(paid / order.recipeCount);",
    "    default:",
    "      throw new RefundError(`Unknown reason: ${reason}`);",
    "  }",
    "}"
   ]
  }
 ],

 "web/src/lib/api.ts": [
  {
   "first": 18,
   "lines": [
    "/** Asks the main server for something, as the logged-in customer. */",
    "export async function api<T>(path: string, init: Init = {}) {",
    "  const token = await loginToken();",
    "  const response = await fetch(apiPath(path), {",
    "    method: init.method ?? 'GET',",
    "    headers: {",
    "      'Content-Type': 'application/json',",
    "      ...(token ? { Authorization: `Bearer ${token}` } : {}),",
    "    },",
    "    body: init.body ? JSON.stringify(init.body) : undefined,",
    "  });",
    "",
    "  if (response.status === 401) {",
    "    await signOut();",
    "    throw new ApiError(401, 'Please log in again');",
    "  }",
    "  if (!response.ok) {",
    "    const problem = await response.json().catch(() => ({}));",
    "    const reason = problem.error ?? 'Server error';",
    "    throw new ApiError(response.status, reason);",
    "  }",
    "  return (await response.json()) as T;",
    "}"
   ]
  }
 ],
 "web/src/config.ts": [
  {
   "first": 1,
   "lines": [
    "// Settings the website needs to talk to the server and to Stripe.",
    "// This file is bundled into the page, so everything in it is public.",
    "",
    "export const config = {",
    "  // Where the main server lives.",
    "  apiUrl: process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:4000',",
    "",
    "  // Stripe: the publishable key is meant for the browser.",
    "  stripePublishableKey: 'pk_live_EXAMPLE_ONLY_not_a_real_key',",
    "",
    "  // FIXME: the secret key must never ship to the browser.",
    "  stripeSecretKey: 'sk_live_EXAMPLE_ONLY_not_a_real_key',",
    "",
    "  // Recipe photos are served straight from the bucket.",
    "  photoBaseUrl: 'https://photos.larder.example/recipes',",
    "",
    "  // How many recipes fit in each box size.",
    "  boxSizes: { small: 3, family: 5 },",
    "",
    "  // Orders close this many hours before billing day.",
    "  cutOffHours: 36,",
    "} as const;",
    "",
    "export type BoxSize = keyof typeof config.boxSizes;",
    "",
    "/** The full address of a server endpoint. */",
    "export function apiPath(path: string): string {",
    "  const base = config.apiUrl.replace(/\\/$/, '');",
    "  const tail = path.startsWith('/') ? path : `/${path}`;",
    "  return `${base}${tail}`;",
    "}"
   ]
  }
 ],

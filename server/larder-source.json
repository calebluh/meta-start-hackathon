 "api/src/db/schema.ts": [
  {
   "first": 38,
   "lines": [
    "/** One weekly plan per customer: which box, and which day. */",
    "export const plans = pgTable('plans', {",
    "  id: uuid('id').primaryKey().defaultRandom(),",
    "  customerId: uuid('customer_id')",
    "    .notNull()",
    "    .references(() => customers.id),",
    "  boxSize: text('box_size').$type<BoxSize>().notNull(),",
    "  deliveryDay: text('delivery_day').$type<Weekday>().notNull(),",
    "  address: jsonb('address').$type<Address>().notNull(),",
    "  status: text('status').$type<PlanStatus>().notNull(),",
    "  pausedUntil: date('paused_until'),",
    "  startedAt: timestamp('started_at').notNull().defaultNow(),",
    "});"
   ]
  }
 ],
 "api/src/db/queries.ts": [
  {
   "first": 61,
   "lines": [
    "/** Every plan that should get a box in the week given. */",
    "export async function activePlansFor(weekStart: string) {",
    "  // A skipped week never reaches billing day or the kitchen.",
    "  const skipped = db",
    "    .select({ planId: skips.planId })",
    "    .from(skips)",
    "    .where(eq(skips.weekStart, weekStart));",
    "",
    "  return db",
    "    .select()",
    "    .from(plans)",
    "    .where(",
    "      and(",
    "        ne(plans.status, 'cancelled'),",
    "        // Paused plans come back once their date has passed.",
    "        notPausedOn(weekStart),",
    "        notInArray(plans.id, skipped),",
    "      ),",
    "    );",
    "}"
   ]
  }
 ],
 "api/src/db/migrations/0007_skips.sql": [
  {
   "first": 1,
   "lines": [
    "-- 0007: a table for skipped weeks.",
    "-- A customer may skip any upcoming week from their account page.",
    "-- Billing day and packing day both leave skipped weeks out.",
    "",
    "BEGIN;",
    "",
    "CREATE TABLE skips (",
    "  id          BIGSERIAL PRIMARY KEY,",
    "  plan_id     UUID NOT NULL REFERENCES plans (id) ON DELETE CASCADE,",
    "  week_start  DATE NOT NULL,",
    "  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),",
    "",
    "  -- Skipping the same week twice is the same as skipping it once.",
    "  CONSTRAINT skips_one_per_week UNIQUE (plan_id, week_start)",
    ");",
    "",
    "-- Billing day looks skips up a week at a time.",
    "CREATE INDEX skips_week_start_idx ON skips (week_start);",
    "",
    "-- Weeks skipped before this table existed were kept as a note",
    "-- on the plan. Move them over, then drop the old column.",
    "INSERT INTO skips (plan_id, week_start)",
    "SELECT id, unnest(skipped_weeks)",
    "FROM plans",
    "WHERE skipped_weeks IS NOT NULL;",
    "",
    "ALTER TABLE plans DROP COLUMN skipped_weeks;",
    "",
    "COMMIT;",
    "",
    "-- To undo:",
    "--   ALTER TABLE plans ADD COLUMN skipped_weeks DATE[];",
    "--   UPDATE plans SET skipped_weeks = ARRAY(",
    "--     SELECT week_start FROM skips WHERE plan_id = plans.id",
    "--   );",
    "--   DROP TABLE skips;",
    "--",
    "-- Checked against a copy of production on 2026-03-02:",
    "-- 4,812 skipped weeks moved, none lost.",
    "-- Runs in under a second; safe to apply while the site is up.",
    "-- Applied to production on 2026-03-04."
   ]
  }
 ],
 "jobs/src/billing.ts": [
  {
   "first": 24,
   "lines": [
    "/** Billing day: charges every plan that has a box next week. */",
    "export async function runBilling(now = new Date()): Promise<Tally> {",
    "  const weekStart = nextWeekStart(now);",
    "  const orders = await buildWeeklyOrders(weekStart);",
    "  const tally: Tally = { charged: 0, declined: 0, skipped: 0 };",
    "",
    "  for (const order of orders) {",
    "    if (order.status !== 'due') {",
    "      tally.skipped += 1; // paid already: never charge twice",
    "      continue;",
    "    }",
    "    const result = await chargeBox(order);",
    "    if (result.ok) {",
    "      await markPaid(order.id, result.chargeId);",
    "      tally.charged += 1;",
    "    } else {",
    "      await queueRetry(order.id, addDays(now, RETRY_DAYS));",
    "      await sendEmail(order.email, 'cardDeclined', RETRY_NOTE);",
    "      tally.declined += 1;",
    "    }",
    "  }",
    "  return tally;",
    "}"
   ]
  }
 ],
 "jobs/src/retry.ts": [
  {
   "first": 19,
   "lines": [
    "/** Tries declined cards again, two days after they failed. */",
    "export async function retryDeclined(now = new Date()) {",
    "  const due = await retriesDueBy(now);",
    "",
    "  for (const retry of due) {",
    "    const order = await orderById(retry.orderId);",
    "    const result = await chargeBox(order);",
    "    if (result.ok) {",
    "      await markPaid(order.id, result.chargeId);",
    "      await clearRetry(retry.id);",
    "    } else if (retry.attempts >= MAX_ATTEMPTS) {",
    "      // Two tries is enough: the box is cancelled for that week.",
    "      await cancelOrder(order.id, 'card_declined');",
    "      await clearRetry(retry.id);",
    "    } else {",
    "      await bumpRetry(retry.id, addDays(now, 2));",
    "    }",
    "  }",
    "}"
   ]
  }
 ],
 "jobs/src/packing.ts": [
  {
   "first": 22,
   "lines": [
    "/** Packing day: groups paid orders into a list for each van route. */",
    "export async function runPacking(weekStart: string) {",
    "  const orders = await paidOrdersFor(weekStart);",
    "  const byRoute = new Map<string, PackingList>();",
    "",
    "  for (const order of orders) {",
    "    const route = routeFor(order.address.postcode);",
    "    const list = byRoute.get(route) ?? { route, boxes: [] };",
    "    list.boxes.push({",
    "      orderId: order.id,",
    "      name: order.customerName,",
    "      recipes: await recipeNamesFor(order.id),",
    "      size: order.boxSize,",
    "    });",
    "    byRoute.set(route, list);",
    "  }",
    "  await savePackingLists(weekStart, [...byRoute.values()]);",
    "  return byRoute.size;",
    "}"
   ]
  }
 ],
 "jobs/src/schedule.ts": [
  {
   "first": 1,
   "lines": [
    "// When each weekly run starts. Times are UK time.",
    "// Started once, by the jobs container, when it boots.",
    "import { schedule } from 'node-cron';",
    "import { runBilling } from './billing';",
    "import { runPacking } from './packing';",
    "import { retryDeclined } from './retry';",
    "import { nextWeekStart } from '../../shared/src/dates';",
    "",
    "const UK = { timezone: 'Europe/London' };",
    "",
    "/** Runs a job and says how it went: no failure goes unseen. */",
    "async function run(name: string, job: () => Promise<unknown>) {",
    "  const started = Date.now();",
    "  try {",
    "    const result = await job();",
    "    const seconds = Math.round((Date.now() - started) / 1000);",
    "    console.log(`[${name}] done in ${seconds}s`, result);",
    "  } catch (error) {",
    "    console.error(`[${name}] failed`, error);",
    "    process.exitCode = 1;",
    "  }",
    "}",
    "",
    "export function startSchedule() {",
    "  // Billing day: Thursday, six in the morning.",
    "  schedule('0 6 * * 4', () => run('billing', runBilling), UK);",
    "",
    "  // Declined cards: tried again every morning at seven.",
    "  schedule('0 7 * * *', () => run('retry', retryDeclined), UK);",
    "",
    "  // Packing day: Saturday, five in the morning, for the week ahead.",
    "  const pack = () => runPacking(nextWeekStart(new Date()));",
    "  schedule('0 5 * * 6', () => run('packing', pack), UK);",
    "",
    "  console.log('Weekly runs scheduled (UK time)');",
    "}",
    "",
    "startSchedule();"
   ]
  }
 ],
 "shared/src/prices.ts": [
  {
   "first": 12,
   "lines": [
    "/** Pence as pounds and pence: 1250 becomes \"£12.50\". */",
    "export function formatMoney(pence: number): string {",
    "  const pounds = Math.floor(Math.abs(pence) / 100);",
    "  const rest = String(Math.abs(pence) % 100).padStart(2, '0');",
    "  return `${pence < 0 ? '-' : ''}£${pounds}.${rest}`;",
    "}",
    "",
    "/** A price with tax added, rounded to the nearest penny. */",
    "export function withTax(pence: number, rate: number): number {",
    "  return Math.round(pence * (1 + rate));",
    "}"
   ]
  }
 ],
 "shared/src/dates.ts": [
  {
   "first": 21,
   "lines": [
    "/** The next date a weekday falls on, on or after the date given. */",
    "export function nextDeliveryDay(from: Date | string, day: Weekday) {",
    "  const date = new Date(from);",
    "  const wanted = WEEKDAYS.indexOf(day);",
    "  const ahead = (wanted - date.getUTCDay() + 7) % 7;",
    "  date.setUTCDate(date.getUTCDate() + ahead);",
    "  return date.toISOString().slice(0, 10);",
    "}"
   ]
  },
  {
   "first": 58,
   "lines": [
    "/** Orders for a week close 36 hours before its billing day. */",
    "export function isPastCutOff(weekStart: string, now = new Date()) {",
    "  const billingDay = new Date(weekStart);",
    "  // Billing day is the Thursday before the week starts.",
    "  billingDay.setUTCDate(billingDay.getUTCDate() - 4);",
    "  const cutOff = billingDay.getTime() - CUT_OFF_HOURS * 3600_000;",
    "  return now.getTime() > cutOff;",
    "}"
   ]
  }
 ],

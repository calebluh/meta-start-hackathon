<!--
  Inspector beside the diorama. Sizes are designed for a scene scale of 0.1,
  so 340px here is 34 cm in the headset. Text is set at runtime by
  DioramaSystem through the element ids.
-->
<style>
  .root {
    flex-direction: column;
    width: 340px;
  }

  .content {
    flex-direction: column;
    gap: 9px;
    padding: 20px;
  }

  .eyebrow {
    color: #4fd1c5;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .title {
    color: #fafaf7;
    font-size: 26px;
    font-weight: 700;
  }

  .wrap {
    width: 300px;
  }

  .summary {
    color: #dddfe3;
    font-size: 16px;
    line-height: 1.35;
  }

  .stats {
    color: #9aa3ad;
    font-size: 14px;
  }

  .alert {
    flex-direction: column;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #4a1d1f;
  }

  .alert-text {
    color: #ffb4ab;
    font-size: 14px;
    line-height: 1.3;
  }

  .recent {
    flex-direction: column;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #173b2b;
  }

  .recent-text {
    color: #a6f4c5;
    font-size: 14px;
    line-height: 1.3;
  }

  .files {
    flex-direction: column;
    gap: 4px;
  }

  .file {
    color: #c9d1d9;
    font-size: 14px;
  }
</style>
<Panel class="root">
  <div class="content">
    <span id="insp-kind" class="eyebrow">CODEBASE</span>
    <span id="insp-title" class="title wrap">Loading</span>
    <span id="insp-summary" class="summary wrap">...</span>
    <span id="insp-stats" class="stats wrap">...</span>
    <div id="insp-alert-box" class="alert">
      <span id="insp-alert" class="alert-text wrap">...</span>
    </div>
    <div id="insp-recent-box" class="recent">
      <span id="insp-recent" class="recent-text wrap">...</span>
    </div>
    <div id="insp-files" class="files">
      <span id="file-0" class="file wrap">...</span>
      <span id="file-1" class="file wrap">...</span>
      <span id="file-2" class="file wrap">...</span>
      <span id="file-3" class="file wrap">...</span>
    </div>
  </div>
</Panel>
